#!/usr/bin/env roc
## Writes `local/bench/checked.roc`, an app with `n` checked queries (200
## when left out), for measuring what checking queries costs at compile
## time. The queries are the shapes an app has: selects with joins and CTEs,
## inserts, updates and deletes, each with a parameter record. Every one is
## valid, so the build succeeds.
##
##     roc tools/bench_checked.roc 50
##     time roc build --no-cache local/bench/checked.roc --output=local/bench/checked
app [main!] {
	pf: platform "https://github.com/roc-lang/basic-cli/releases/download/0.25.0/CZsY7tYZwR3rj9kYbpaCfxki2yVAaRL8bBwMLvB2xkbA.tar.zst",
}

import pf.Stdout
import pf.Path
import pf.OsStr

main! : List(OsStr) => Try({}, _)
main! = |args| {
	n =
		match args {
			[] => 200
			[arg] => U64.from_str(OsStr.display(arg)) ? |_| UsageArgs("[n]")
			_ => return Err(UsageArgs("[n]"))
		}
	Path.create_all!(Path.utf8("local/bench"))?
	Path.write_utf8!(Path.utf8("local/bench/checked.roc"), bench_app(n))?
	Stdout.line!("wrote local/bench/checked.roc with ${n.to_str()} checked queries")
}

bench_app : U64 -> Str
bench_app = |n| {
	var $defs = []
	var $calls = []
	var $i = 0
	while $i < n {
		$defs = $defs.append(query($i))
		$calls = $calls.append("\t_ = q${$i.to_str()}!(db)?")
		$i = $i + 1
	}
	Str.join_with([header, Str.join_with($defs, "\n\n"), main_start, Str.join_with($calls, "\n"), main_end], "\n")
}

## One query, a shape picked by `i`, with `i` in a literal so no two are
## the same string.
query : U64 -> Str
query = |i| {
	k = i.to_str()
	name = "q${k}!"
	match i % 8 {
		0 => "${name} : Db => Try(List({ id : I32, name : Str }), _)\n${name} = |db| db.query!(\"select id, name from students where school_id = $school_id and id > ${k} order by name\", { school_id: 1.I32 })"
		1 => "${name} : Db => Try(List({ id : I32, school : Str }), _)\n${name} = |db| db.query!(\"select r.id, o.name as school from students r join schools o on o.id = r.school_id where o.name = $name and r.id <> ${k}\", { name: \"x\" })"
		2 => "${name} : Db => Try(U64, _)\n${name} = |db| {\n\tphone : Try(Str, [Null])\n\tphone = Ok(\"1\")\n\tdb.execute!(\"insert into students (id, name, phone, school_id) values ($id, $name, $phone, ${k})\", { id: 1.I32, name: \"x\", phone })\n}"
		3 => "${name} : Db => Try(U64, _)\n${name} = |db| {\n\tphone : Try(Str, [Null])\n\tphone = Err(Null)\n\tdb.execute!(\"update students set phone = $phone where id = $id and school_id <> ${k}\", { phone, id: 1.I32 })\n}"
		4 => "${name} : Db => Try(U64, _)\n${name} = |db| db.execute!(\"delete from students where id = $id and school_id = ${k}\", { id: 1.I32 })"
		5 => "${name} : Db => Try({ n : I64 }, _)\n${name} = |db| db.query_one!(\"select count(*) as n from students where school_id = $school_id and id > ${k}\", { school_id: 1.I32 })"
		6 => "${name} : Db => Try(List({ id : I32 }), _)\n${name} = |db| db.query!(\"with recent as (select id from students where id > $min_id) select id from recent order by id limit ${k}\", { min_id: 1.I32 })"
		_ => "${name} : Db => Try(Try({ name : Str, phone : Try(Str, [Null]) }, [NotFound]), _)\n${name} = |db| db.query_optional!(\"select name, phone from students where name like $pattern or (phone is null and id = ${k}) order by name desc limit 1\", { pattern: \"a%\" })"
	}
}

header =
	\\## Generated by tools/bench_checked.roc.
	\\app [main!] {
	\\	pf: platform "https://github.com/roc-lang/basic-cli/releases/download/0.25.0/CZsY7tYZwR3rj9kYbpaCfxki2yVAaRL8bBwMLvB2xkbA.tar.zst",
	\\	pg: "../../package/main.roc",
	\\}
	\\
	\\import pf.Stdout
	\\import pf.Tcp
	\\import pf.Random
	\\import pf.OsStr
	\\import pg.Client
	\\import pg.Catalog
	\\
	\\schema_sql =
	\\	\\\\CREATE TABLE public.schools (
	\\	\\\\    id integer NOT NULL,
	\\	\\\\    name text NOT NULL
	\\	\\\\);
	\\	\\\\CREATE TABLE public.students (
	\\	\\\\    id integer NOT NULL,
	\\	\\\\    name text NOT NULL,
	\\	\\\\    phone text,
	\\	\\\\    school_id integer NOT NULL
	\\	\\\\);
	\\
	\\catalog : Catalog
	\\catalog = Catalog.from_schema(schema_sql)
	\\
	\\Schema := [].{
	\\	catalog : {} -> Catalog
	\\	catalog = |{}| catalog
	\\}
	\\
	\\Db : Client.Client(Tcp.Stream, Schema)
	\\

main_start =
	\\
	\\main! : List(OsStr) => Try({}, _)
	\\main! = |_args| {
	\\	db = Client.connect!({ connect!: Tcp.connect!, random_u64!: Random.seed_u64!, host: "localhost", port: 5432, user: "postgres", database: "postgres", auth: NoAuth, timeout_ms: 5000 })?

main_end =
	\\	Stdout.line!("done")
	\\}
	\\
